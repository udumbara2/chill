{
  "name": "assistant-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI助手用户界面",
  "main": "packages/electron/dist/electron-main.js",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "scripts": {
    "dev": "pnpm --filter @assistant-ai/electron dev:renderer",
    "build": "pnpm --filter @assistant-ai/native-desktop build && pnpm --filter @assistant-ai/core build && pnpm --filter @assistant-ai/web build && pnpm --filter @assistant-ai/ui build && pnpm --filter @assistant-ai/electron build:renderer && pnpm --filter @assistant-ai/electron build",
    "electron:dev": "pnpm --filter @assistant-ai/electron start:dev",
    "electron:build": "pnpm run build && pnpm --filter @assistant-ai/electron run pack",
    "electron:start": "pnpm --filter @assistant-ai/electron build && electron .",
    "build:core": "pnpm --filter @assistant-ai/core build",
    "build:cli": "pnpm --filter @assistant-ai/chill-cli build",
    "clean:packages": "pnpm -r --parallel clean",
    "setup": "pnpm install && pnpm build && pnpm build:cli && cd packages/cli && npm link --force"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@vitejs/plugin-vue": "^4.3.1",
    "eslint": "^10.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^4.4.9",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vue-tsc": "^2.1.6"
  },
  "build": {
    "appId": "com.assistant.app",
    "productName": "AI助手",
    "electronVersion": "28.3.3",
    "electronDist": "packages/electron/node_modules/electron/dist",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "packages/dist/**/*",
      "packages/electron/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "packages/electron/resources/workers",
        "to": "workers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/core/src/orchestrator/templates/builtin",
        "to": "templates/builtin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/core/src/skills/builtin",
        "to": "skills/builtin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/native-desktop",
        "to": "native-desktop",
        "filter": [
          "index.js",
          "*.node"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {}
}
